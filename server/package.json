{
  "name": "photographer-website-backend",
  "version": "1.0.0",
  "description": "Production-grade backend for a photographer portfolio & booking platform",
  "main": "server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "seed:photos": "cross-env NODE_ENV=development node scripts/seedPhotos.js",
    "check-env": "node scripts/check-env.js",
    "check-env:live": "node scripts/check-env.js --live",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --forceExit --coverage"
  },
  "keywords": [
    "photographer",
    "booking",
    "portfolio",
    "mern",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "mongoose": "^8.4.4",
    "razorpay": "^2.9.2",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
   "setupFilesAfterEnv": ["./tests/setup.js"] 
  }
}