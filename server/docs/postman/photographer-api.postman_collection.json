            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"isFeatured\": true\n}"
            }
          }
        },
        {
          "name": "Delete Photo",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/photos/{{photoId}}",
            "auth": { "type": "noauth" }
          }
