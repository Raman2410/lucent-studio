# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this to .env.development or .env.production
# Fill in all values before running the server
# The app will CRASH on startup if any required key is missing
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────
NODE_ENV=                         # development | production | test
PORT=                             # e.g. 5000

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
MONGO_URI=                        # MongoDB connection string
                                  # Local:   mongodb://localhost:27017/photographer_dev
                                  # Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/dbname

# ─────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────
REDIS_HOST=                       # e.g. localhost or your Redis cloud host
REDIS_PORT=                       # default: 6379
REDIS_PASSWORD=                   # leave empty if no auth (local dev)

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_SECRET=                       # min 32 chars random string — keep secret!
JWT_EXPIRES_IN=                   # e.g. 7d
JWT_COOKIE_EXPIRES_IN=            # in days, e.g. 7

# ─────────────────────────────────────────
# AWS S3
# ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=                # IAM user access key
AWS_SECRET_ACCESS_KEY=            # IAM user secret key
AWS_BUCKET_NAME=                  # S3 bucket name
AWS_REGION=                       # e.g. ap-south-1 (Mumbai)

# ─────────────────────────────────────────
# NODEMAILER (GMAIL SMTP)
# ─────────────────────────────────────────
SMTP_EMAIL=                       # Gmail address used to send emails
SMTP_PASSWORD=                    # Gmail App Password (not your regular password)
                                  # Generate at: myaccount.google.com/apppasswords
EMAIL_FROM=                       # Display name + email e.g. "Studio <email@gmail.com>"

# ─────────────────────────────────────────
# RAZORPAY
# ─────────────────────────────────────────
RAZORPAY_KEY_ID=                  # From Razorpay dashboard
RAZORPAY_KEY_SECRET=              # From Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=          # From Razorpay dashboard → Webhooks → Secret (required — webhook requests are rejected without it)

# ─────────────────────────────────────────
# CLAUDE AI (ANTHROPIC)
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=                # From console.anthropic.com

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CLIENT_URL=                       # Frontend URL e.g. http://localhost:3000

# ─────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=             # Time window in ms e.g. 900000 (15 mins)
RATE_LIMIT_MAX=                   # Max requests per window e.g. 100
